class LiveOutputWindow(Adw.Window):
    def __init__(self, parent, fix_title):
        super().__init__(transient_for=parent, modal=True,
                         default_width=560, default_height=420,
                         title=fix_title)
        tb = Adw.ToolbarView()
        tb.add_top_bar(Adw.HeaderBar())

        # scrollable text area for live output
        sw = Gtk.ScrolledWindow()
        sw.set_vexpand(True)
        sw.set_hexpand(True)

        self._buf = Gtk.TextBuffer()
        tv = Gtk.TextView(buffer=self._buf,
                          editable=False,
                          wrap_mode=Gtk.WrapMode.WORD_CHAR,
                          monospace=True,
                          margin_top=12, margin_bottom=12,
                          margin_start=12, margin_end=12)
        sw.set_child(tv)

        # status label at the bottom, click to close dialog
        self._status = Gtk.Label(label="Running…",
                                 margin_top=6, margin_bottom=6)
        self._status.add_css_class("dim-label")

        self._close_btn = Gtk.Button(label="Close",
                                     margin_bottom=10,
                                     margin_start=80,
                                     margin_end=80)
        self._close_btn.add_css_class("suggested-action")
        self._close_btn.connect("clicked", lambda _: self.close())
        self._close_btn.set_visible(False)   # hidden while running

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(sw)
        box.append(self._status)
        box.append(self._close_btn)

        tb.set_content(box)
        self.set_content(tb)

        # keep a reference to the end of the text buffer for auto-scroll
        self._end_mark = self._buf.create_mark(
            "end", self._buf.get_end_iter(), left_gravity=False)
        self._tv = tv

    def append_line(self, line):
        """Called from GLib.idle_add — adds one line to the text box."""
        it = self._buf.get_end_iter()
        self._buf.insert(it, line)
        # auto-scroll to the bottom
        self._tv.scroll_to_mark(self._end_mark, 0, False, 0, 0)

    def set_done(self, success):
        """Called when the script finishes."""
        if success:
            self._status.set_text("✓ Done successfully")
            self._status.remove_css_class("dim-label")
            self._status.add_css_class("success")
        else:
            self._status.set_text("✗ Script finished with errors")
            self._status.remove_css_class("dim-label")
            self._status.add_css_class("error")
        self._close_btn.set_visible(True)   # show Close button when done

class FixHelperWindow(Adw.ApplicationWindow):
    def __init__(self, app, catalog):
        super().__init__(application=app, title="LinuxFixIt",
                         default_width=680, default_height=640)
        tb = Adw.ToolbarView()
        tb.add_top_bar(Adw.HeaderBar())
        self.toast = Adw.ToastOverlay()
        page = Adw.PreferencesPage()
        cats = {}
        for fix in catalog["fixes"]:
            cats.setdefault(fix.get("category", "General"), []).append(fix)
        for name, fixes in cats.items():
            grp = Adw.PreferencesGroup(title=name)
            for fix in fixes:
                grp.add(self._row(fix))
            page.add(grp)
        sw = Gtk.ScrolledWindow()
        sw.set_child(page)
        sw.set_vexpand(True)
        sw.set_overlay_scrolling(False)   # always-visible scrollbar on the right
        self.toast.set_child(sw)
        tb.set_content(self.toast)
        self.set_content(tb)

    def _row(self, fix):
        row = Adw.ActionRow(title=fix["title"], subtitle=fix.get("description", ""))
        row.set_subtitle_lines(0)
        priv = fix.get("privilege", "none")
        if fix["type"] == "script":
            if priv == "local-admin-login":
                badge = Gtk.Label(label="Requires local admin login")
                badge.add_css_class("dim-label")
                badge.set_valign(Gtk.Align.CENTER)
                row.add_suffix(badge)
            else:
                btn = Gtk.Button(label="Fix it", valign=Gtk.Align.CENTER)
                btn.add_css_class("suggested-action")
                if priv == "root":
                    btn.set_tooltip_text("An administrator password will be requested")
                btn.connect("clicked", self._run, fix)
                row.add_suffix(btn)
        elif fix["type"] == "manual":
            btn = Gtk.Button(label="Show steps", valign=Gtk.Align.CENTER)
            btn.connect("clicked", self._steps, fix)
            row.add_suffix(btn)
        return row

    def _steps(self, _b, fix):
        log_feedback(fix["id"], "steps_opened")
        try:
            ManualStepsWindow(self, fix).present()
        except Exception as e:
            self.toast.add_toast(Adw.Toast(title=f"Could not open steps: {e}"))

    # for script fixes: run the script in a thread, show live output, then show final result dialog
    def _run(self, button, fix):
        script = os.path.join(catalog_dir(), "fixes", fix["script"])
        if not os.path.isfile(script):
            self.toast.add_toast(Adw.Toast(title=f"Script not found: {script}"))
            return
        cmd = (["pkexec", "/bin/bash", script]
               if fix.get("privilege") == "root" else ["/bin/bash", script])

        # open the live output window immediately
        win = LiveOutputWindow(self, fix["title"])
        win.present()

        button.set_sensitive(False)
        button.set_label("Running…")
        log_feedback(fix["id"], "script_started")
        threading.Thread(target=self._thread,
                         args=(cmd, fix, button, win), daemon=True).start()

    # Run the script in a background thread, sending output lines to the live output window as they come in.
    def _thread(self, cmd, fix, button, win):
        try:
            proc = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,   # merge stderr into stdout
                text=True,
            )
            # read one line at a time and send to the window
            for line in proc.stdout:
                GLib.idle_add(win.append_line, line)
            proc.wait()
            rc = proc.returncode
        except Exception as e:
            rc = 1
            GLib.idle_add(win.append_line, f"\nError: {e}\n")

        GLib.idle_add(self._done, fix, button, win, rc)

    # After the script finishes, update the live output window with the final status and re-enable the button.
    def _done(self, fix, button, win, rc):
        button.set_sensitive(True)
        button.set_label("Fix it")
        if rc in (126, 127):
            win.set_done(False)
            win.append_line("\nCancelled — administrator authentication is required.\n")
            log_feedback(fix["id"], "auth_cancelled")
            return False
        log_feedback(fix["id"], "script_finished", f"rc={rc}")
        win.set_done(rc == 0)
        return False


class FixHelperApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        win = self.get_active_window()
        if not win:
            try:
                catalog = load_catalog()
            except Exception as e:
                d = Gtk.MessageDialog(text=f"Could not load catalog:\n{e}")
                d.present()
                return
            win = FixHelperWindow(self, catalog)
        win.present()


if __name__ == "__main__":
    sys.exit(FixHelperApp().run(sys.argv))
